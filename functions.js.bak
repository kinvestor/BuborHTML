// сохранение и загрузка

function saveProgress() {
    const gameData = {
        level: level,                           // Сохраняем текущий уровень
        lives: lives,                           // Сохраняем количество жизней
        nutImgSrc: nutImg.src,                  // Изображение предметов
        groundImgSrc: groundImg.src,            // Изображение земли
        wolfImgSrc: wolfImg.src,                // Изображение врага
        collectiblesName: collectiblesName,     // Название предметов
        musicSrc: backgroundMusic.src           // Сохраняем путь к текущей музыке
    };
    localStorage.setItem('gameProgress', JSON.stringify(gameData));
    console.log("Прогресс сохранён:", gameData);
}

function loadProgress() {
    const savedData = localStorage.getItem('gameProgress');
    if (savedData) {
        const gameData = JSON.parse(savedData);
        level = gameData.level || 1;                               // Загружаем уровень
        lives = gameData.lives || 3;                               // Загружаем жизни
        nutImg.src = gameData.nutImgSrc || 'nut.png';              // Восстанавливаем изображение предметов
        groundImg.src = gameData.groundImgSrc || 'ground1.png';    // Восстанавливаем изображение земли
        wolfImg.src = gameData.wolfImgSrc || 'img/char/wolficon.png'; // Восстанавливаем изображение врага
        collectiblesName = gameData.collectiblesName || "Орешки: ";    // Восстанавливаем название предметов
        currentBackgroundImg = backgroundImgs[level - 1];          // Устанавливаем нужный фон

        // Восстанавливаем сохранённую музыку
        if (gameData.musicSrc) {
            backgroundMusic.pause(); // Останавливаем текущую музыку
            backgroundMusic.src = gameData.musicSrc; // Устанавливаем сохраненный трек
            backgroundMusic.load();
            backgroundMusic.play();
        }

        console.log("Прогресс загружен:", gameData);

        // Перезапуск уровня с загруженными настройками
        resetLevel();
    } else {
        console.log("Сохранённых данных не найдено, игра начнётся с первого уровня.");
        level = 1;
        lives = 3;
        resetLevel();
    }
    togglePause();
}

// Анимации и рендеринг ловушек

let blink = 1; // Переменная для управления прозрачностью (мерцание)
let shakeOffsetX = 0; // Смещение для вибрации по X
let shakeOffsetY = 0; // Смещение для вибрации по Y
let blinkSpeed = 0.1; // Скорость мигания

// Обновляем переменные для мерцания и вибрации
function updateTrapEffects() {
    // Мерцание
    blink = blink === 1 ? 0.7 : 1;

    // Вибрация
    shakeOffsetX = Math.random() * 2 - 1; // Случайное смещение по X
    shakeOffsetY = Math.random() * 2 - 1; // Случайное смещение по Y
}

// Рендерим ловушки с мерцанием и вибрацией
function renderTraps() {
    traps.forEach(trap => {
        ctx.save();
        ctx.globalAlpha = blink; // Устанавливаем прозрачность для мерцания
        ctx.translate(trap.x + shakeOffsetX, trap.y + shakeOffsetY); // Применяем смещения для вибрации
        ctx.drawImage(trapImg, 0, 0, trap.width, trap.height);
        ctx.restore();
    });
}

let explosions = []; // Массив для хранения частиц взрыва

function createExplosion(x, y) {
    for (let i = 0; i < 20; i++) { // Количество частиц в взрыве
        explosions.push({
            x: x,
            y: y,
            dx: (Math.random() - 0.5) * 4, // Случайное направление по оси X
            dy: (Math.random() - 0.5) * 4, // Случайное направление по оси Y
            color: `rgba(255, ${Math.random() * 255}, 0, 1)`, // Оранжево-красный цвет
            life: 30 // Время жизни частиц
        });
    }
}

function updateExplosions() {
    explosions.forEach((particle, index) => {
        particle.x += particle.dx;
        particle.y += particle.dy;
        particle.dy += 0.1; // Гравитация для частиц
        particle.life--;

        if (particle.life <= 0) {
            explosions.splice(index, 1); // Удаляем частицу после завершения
        }
    });
}

function renderExplosions(ctx) {
    explosions.forEach(particle => {
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = particle.color;
        ctx.fill();
    });
}

// функция отрисовки эффекта бонуса неуязвимости
function updateInvincibilityBonus() {
    if (invincibilityBonus) {
        invincibilityBonus.hue += 1; // Изменение цвета
        if (invincibilityBonus.hue >= 360) {
            invincibilityBonus.hue = 0; // Сброс после полного цикла цветов
        }
    }
}


// Функции для погодных эффектов

let particles = []; // Массив для хранения частиц

function createWeatherEffect() {
    particles = []; // Очищаем частицы при смене уровня
    let particleCount = 100; // Количество частиц

    if (level >= 4 && level <= 6) {
        // Дождь
        for (let i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                speedY: 5 + Math.random() * 3, // Скорость капель
                length: 10 + Math.random() * 10, // Длина капель
                color: 'rgba(0, 119, 190, 0.5)' // Синий оттенок для дождя
            });
        }
    } else if (level >= 34 && level <= 36) {
        // Снег
        for (let i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                speedY: 1 + Math.random() * 1.5, // Скорость падения снега
                size: 3 + Math.random() * 3, // Размер снежинок
                color: 'rgba(255, 255, 255, 0.8)' // Белый цвет для снега
            });
        }
    } else if (level >= 10 && level <= 12) {
        // Туман
        for (let i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                speedX: -0.5 + Math.random(), // Медленное горизонтальное движение
                size: 20 + Math.random() * 30, // Крупные частицы тумана
                color: 'rgba(200, 200, 200, 0.15)' // Полупрозрачный серый
            });
        }
    }
    else if (level >= 24 && level <= 29) {
        // Пепел
        for (let i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                speedY: -0.5 + Math.random() * -1.5, // Поднимается вверх
                size: 2 + Math.random() * 2, // Мелкие частицы
                color: 'rgba(105, 105, 105, 0.5)' // Тёмно-серый для пепла
            });
        }
    }
}

// Функция для обновления положения частиц
function updateParticles() {
    particles.forEach(particle => {
        if (level >= 4 && level <= 6) {
            // Дождь
            particle.y += particle.speedY;
            if (particle.y > canvas.height) {
                particle.y = -particle.length; // Возвращаем каплю наверх
            }
        } else if (level >= 34 && level <= 36) {
            // Снег
            particle.y += particle.speedY;
            if (particle.y > canvas.height) {
                particle.y = -particle.size; // Возвращаем снежинку наверх
            }
        } else if (level >= 10 && level <= 12) { // Туман
            particle.x += particle.speedX;
            if (particle.x < -particle.size) {
                particle.x = canvas.width + particle.size; // Перемещаем туман обратно справа
            }
        } else if (level >= 24 && level <= 29) { // Пепел
            particle.y += particle.speedY;
            if (particle.y < -particle.size) {
                particle.y = canvas.height; // Возвращаем пепел вниз
            }
        }

    });
}

// Функция для отрисовки частиц на экране
function renderParticles() {
    particles.forEach(particle => {
        ctx.beginPath();
        if (level >= 4 && level <= 6) {
            // Дождь
            ctx.strokeStyle = particle.color;
            ctx.lineWidth = 1;
            ctx.moveTo(particle.x, particle.y);
            ctx.lineTo(particle.x, particle.y + particle.length);
            ctx.stroke();
        } else if (level >= 34 && level <= 36) {
            // Снег
            ctx.fillStyle = particle.color;
            ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
            ctx.fill();
        } else if (level >= 10 && level <= 12) { // Туман
            ctx.fillStyle = particle.color;
            ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
            ctx.fill();
        } else if (level >= 24 && level <= 29) { // Пепел
            ctx.fillStyle = particle.color;
            ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
            ctx.fill();
        }

        ctx.closePath();
    });
}

function StoryAdvance() {
    // Проверяем, является ли уровень кратным 3
    if (level % 3 !== 0 || level > 33) return;

    isPaused = true; // Включаем паузу
